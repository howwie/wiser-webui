# Copy this file to .env and fill it in. Never commit .env or share it: it holds your hub secret.

# The hub's LAN address. Give it a DHCP reservation on your router so it doesn't change.
WISER_HUB_HOST=192.168.1.50

# The hub's secret (sent as the SECRET header). See README.md for how to get it.
WISER_SECRET=

# Optional: require a password to use the page (any username). Strongly recommended.
WISER_UI_PASSWORD=

# Optional: host names you open the page by (comma-separated), e.g. nas.lan,heating.local.
# IP addresses and localhost always work; any other name is refused unless listed here.
WISER_ALLOWED_HOSTS=

# How often to read the hub, in seconds (minimum 5). The hub is small, so don't go lower than ~15.
WISER_POLL_SECONDS=20

# How many degrees a boost adds to the room's current target.
WISER_BOOST_INCREASE=2

# Set to 1 to run with fake demo data and no hub (WISER_HUB_HOST and WISER_SECRET are then ignored).
WISER_MOCK=0
